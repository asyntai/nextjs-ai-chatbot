{
  "name": "nextjs-ai-chatbot",
  "version": "1.0.0",
  "description": "Add the Asyntai AI chat assistant to your Next.js site, including Fumadocs and Nextra docs. It answers visitor questions from your own content, in 80+ languages.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "nextjs",
    "next",
    "react",
    "fumadocs",
    "nextra",
    "chatbot",
    "ai",
    "chat",
    "live-chat",
    "support",
    "customer-support",
    "asyntai"
  ],
  "homepage": "https://asyntai.com/documentation/integrations/nextjs/",
  "bugs": {
    "url": "https://github.com/asyntai/nextjs-ai-chatbot/issues",
    "email": "hello@asyntai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyntai/nextjs-ai-chatbot.git"
  },
  "author": "Asyntai <hello@asyntai.com> (https://asyntai.com)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "test": "node tests/test_core.js"
  },
  "peerDependencies": {
    "next": ">=13.4.0",
    "react": ">=18.0.0"
  }
}
